# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vetcarepro
DB_USER=postgres
DB_PASSWORD=your_password_here

# Flask Configuration
FLASK_PORT=5001
FLASK_DEBUG=True

# Model Storage
MODEL_PATH=./models
DATA_PATH=./data

# Ollama (local, free LLM + embeddings for the RAG AI assistant)
# Run `ollama serve` locally, and pull both models first:
#   ollama pull nomic-embed-text
#   ollama pull qwen3.5:9b
# qwen3.5:9b is used for EVERY generation call in this app, text and vision
# alike (including the pet-owner "photo guidance" feature) - this deployment
# only runs one chat model locally, so there is deliberately no separate
# vision-only model.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=60
# Separate, longer timeout for admin-only "show reasoning" calls (thinking
# mode measured at ~24x slower) - only used when a request explicitly asks
# the model to think.
OLLAMA_THINK_TIMEOUT=240
# Vision calls (see generate_vision_answer / scripts/rag/photo_guidance.py)
# measured at ~195s for a single response - well above every other timeout.
OLLAMA_VISION_TIMEOUT=300

# Path to the Node backend's uploads/ dir, used by the photo guidance
# feature to read an uploaded pet photo off disk. Assumes both services run
# on the same machine (true in local dev - see run.sh).
UPLOADS_DIR=../server/uploads
