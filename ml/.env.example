# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vetcarepro
DB_USER=postgres
DB_PASSWORD=your_password_here

# Flask Configuration
FLASK_PORT=5001
FLASK_DEBUG=True

# Model Storage
MODEL_PATH=./models
DATA_PATH=./data

# Ollama (local, free LLM + embeddings for the RAG AI assistant)
# Run `ollama serve` locally, and pull both models first:
#   ollama pull nomic-embed-text
#   ollama pull qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60
# Separate, longer timeout for admin-only "show reasoning" calls (thinking
# mode measured at ~24x slower) - only used when a request explicitly asks
# the model to think.
OLLAMA_THINK_TIMEOUT=240
